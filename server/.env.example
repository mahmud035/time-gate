# Template only — this file is committed, so it must never hold a real value.
#
# NODE_ENV selects which file is loaded:
#   .env.development   local development  (npm run dev)
#   .env.production    production-mode run on this machine
#
# Both are gitignored and neither is deployed. On Railway there is no file at
# all: set these as dashboard variables instead, and they take precedence over
# any file anyway.
#
# Copy this to server/.env.development to get started.

NODE_ENV=development
PORT=5000

# MongoDB Atlas. MONGODB_DB keeps pitch and production data on separate
# databases within the same cluster.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=timegate-dev

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# Domain rules
TIMEZONE=Europe/London
OPEN_SHIFT_LIMIT_HOURS=16
PAY_WEEK_START=monday

# The punch page lives at /p/<PUNCH_SLUG>. Staff reach it from a link, so this
# is never typed — make it long and random, and rotate it by changing this
# value. Minimum 16 characters.
PUNCH_SLUG=change-me-to-a-long-random-slug

# Keys the staff-code lookup index. Separate from JWT_ACCESS_SECRET so rotating
# the token secret signs managers out without stopping staff clocking in.
# Changing this orphans every existing code — reissue them all if you do.
PUNCH_CODE_PEPPER=change-me-to-a-long-random-string-at-least-32-chars
