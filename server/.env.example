# Copy to .env for local development. Never commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas. MONGODB_DB keeps demo and production data on separate
# databases within the same cluster (see plan §9).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=timegate_dev

# Auth
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

# Domain rules
TIMEZONE=Europe/London
OPEN_SHIFT_LIMIT_HOURS=16
PAY_WEEK_START=monday

# Only used by the Vite dev proxy locally; production is same-origin.
CLIENT_ORIGIN=http://localhost:5173
